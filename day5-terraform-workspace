#now lets create the workspace
  #thsi will show all the command related to workspace
terraform workspace                                                                                                  
terraform workspace show                              
  #this will create a workspace called as dev
terraform workspace new dev                                                                                          
terraform workspace show        
  #to apply in dev workspace we will pass the dev.tfvars file using --var-file
terraform apply --var-file=dev.tfvars                                                                                
terraform workspace list                                                                                             
terraform workspace new prod                                                                                         
terraform workspace list                                                                                             
terraform apply --var-file=prod.tfvars     
  ##once both the workspace is created verify
  1. Go to vpc you will see there are two vpc with your name prod and dev
  2. go to ec2 instance you will see there are two type of instance prod and dev
  3. go to load balancer you will see dev and prod lb
#lets destroy the resources. 
terraform destroy --auto-approve
terraform workspace select dev
terraform destroy --auto-approve
